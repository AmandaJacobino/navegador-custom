{
  "name": "navegador-custom",
  "version": "0.1.0",
  "description": "Navegador pessoal com interface própria sobre o motor Chromium (Electron)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --no-sandbox --ozone-platform=wayland",
    "watch": "bun --watch run dev"
  },
  "devDependencies": {
    "electron": "^31.7.7"
  },
  "allowScripts": {
    "electron@31.7.7": true
  },
  "dependencies": {
    "node-sqlite3-wasm": "0.8.60"
  }
}
